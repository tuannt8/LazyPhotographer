<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LazyPhotographer.Avalonia.ViewModels"
             x:Class="LazyPhotographer.Avalonia.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer Margin="24,16">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="20">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="⚙ Settings &amp; Performance" Foreground="White" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Configure in-memory caching and resolution limits. Settings are remembered automatically." Foreground="#888888" FontSize="13" />
            </StackPanel>

            <!-- Card 1: Thumbnail Cache (Grid View) -->
            <Border Background="#1E1E22" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Thumbnail Cache Size" Foreground="White" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Number of small thumbnails kept in memory for high-speed, lag-free scrolling." Foreground="#888888" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2A2A32" Padding="12,4" CornerRadius="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ThumbnailCacheSizeSetting, StringFormat='{}{0} items'}" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Slider Minimum="20" Maximum="1000" Value="{Binding ThumbnailCacheSizeSetting}" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="20 (Low RAM)" Foreground="#666666" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="1000 (Maximum Performance)" Foreground="#666666" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: High-Resolution Loupe Cache -->
            <Border Background="#1E1E22" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="High-Resolution Loupe Cache Size" Foreground="White" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Number of full-resolution HD previews cached in memory for instant switching in Loupe mode." Foreground="#888888" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2A2A32" Padding="12,4" CornerRadius="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HighResCacheSizeSetting, StringFormat='{}{0} images'}" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Slider Minimum="5" Maximum="100" Value="{Binding HighResCacheSizeSetting}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="5 images (~15 MB)" Foreground="#666666" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="100 images (~250 MB)" Foreground="#666666" FontSize="11"/>
                    </Grid>

                    <Separator Background="#2A2A30" Margin="0,4"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="High-Resolution Max Dimension" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Specifies the target resolution for Loupe mode preview rendering." Foreground="#888888" FontSize="12" />
                        <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                            <Slider Grid.Column="0" Minimum="1280" Maximum="3840" Value="{Binding HighResMaxDimensionSetting}" TickFrequency="640" IsSnapToTickEnabled="True" Margin="0,0,16,0"/>
                            <Border Grid.Column="1" Background="#2A2A32" Padding="12,4" CornerRadius="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HighResMaxDimensionSetting, StringFormat='{}{0} px'}" Foreground="#FFB300" FontSize="12" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Cache Usage & Maintenance -->
            <Border Background="#1E1E22" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Memory &amp; Storage Maintenance" Foreground="White" FontSize="15" FontWeight="Bold" />

                    <!-- Live Stats Pill -->
                    <Border Background="#151518" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CacheStatsText}" Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="Auto, Auto, *">
                        <Button Grid.Column="0" Content="🗑️ Clear Cache Now"
                                Command="{Binding ClearCacheCommand}"
                                Background="#3A2222" Foreground="#FF6B6B" Height="36" Padding="16,0" CornerRadius="6" FontWeight="Bold" Margin="0,0,12,0" VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1" Content="↺ Reset to Defaults"
                                Command="{Binding ResetSettingsCommand}"
                                Background="#2A2A30" Foreground="#CCCCCC" Height="36" Padding="14,0" CornerRadius="6" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="{Binding SettingsFeedback}" Foreground="#00E676" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
