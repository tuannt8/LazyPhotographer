<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LazyPhotographer.Avalonia.Models"
             xmlns:commonModels="clr-namespace:LazyPhotographer.Models;assembly=LazyPhotographer.Common"
             xmlns:vm="clr-namespace:LazyPhotographer.Avalonia.ViewModels"
             x:Class="LazyPhotographer.Avalonia.Views.ExportView"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="*, 450" Background="#141416" Margin="20">
        <!-- Left: Selected Images for Export -->
        <Border Grid.Column="0" Background="#1E1E22" CornerRadius="8" Padding="16" Margin="0,0,16,0">
            <Grid RowDefinitions="Auto, Auto, *">
                <TextBlock Grid.Row="0" Text="IMAGES TO EXPORT" Foreground="#FFB300" FontSize="13" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="{Binding FlaggedPhotosCountText}" Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,12" />

                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding FlaggedPhotos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <Border Width="180" Margin="5" Background="#121214" CornerRadius="6" BorderThickness="1" BorderBrush="#2E2E32" Padding="4">
                                    <Grid RowDefinitions="120, Auto">
                                        <Image Grid.Row="0" Source="{Binding Thumbnail}" Stretch="UniformToFill" Height="120" />
                                        <StackPanel Grid.Row="1" Margin="4,4,4,2">
                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ExposureInfo}" Foreground="#777777" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: Export Presets and Controls -->
        <Border Grid.Column="1" Background="#1E1E22" CornerRadius="8" Padding="20">
            <ScrollViewer>
                <StackPanel Spacing="18">
                    <TextBlock Text="EXPORT PRESET &amp; DESTINATION" Foreground="#4FC3F7" FontSize="13" FontWeight="Bold" />

                    <!-- Presets Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Choose Output Preset:" Foreground="#D4D4D4" FontSize="12" />
                        <ListBox ItemsSource="{Binding ExportPresets}"
                                 SelectedItem="{Binding SelectedExportPreset}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="commonModels:ExportPresetModel">
                                    <Border Background="#28282D"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A40"
                                            CornerRadius="6"
                                            Padding="10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" Foreground="#888888" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Preset" Foreground="#007ACC" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Destination Directory -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Destination Folder:" Foreground="#D4D4D4" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseExportFolderCommand}"
                                    Background="#2A2A2E" Foreground="#D4D4D4" Height="26" Padding="10,0" CornerRadius="4" FontSize="11" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Border Background="#141416" CornerRadius="6" BorderThickness="1" BorderBrush="#333337" Padding="10,8">
                            <TextBlock Text="{Binding ExportDestinationFolder}" Foreground="#CCCCCC" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>

                    <!-- Export Progress and Status -->
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                        <ProgressBar Minimum="0.0" Maximum="1.0"
                                     Value="{Binding ExportProgress}"
                                     Foreground="#007ACC"
                                     Height="8" />
                        <TextBlock Text="{Binding ExportStatus}"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Button Content="🚀 Export Selected / Flagged Images"
                            Command="{Binding StartExportCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#007ACC"
                            Foreground="White"
                            Height="46"
                            CornerRadius="8"
                            FontSize="14"
                            FontWeight="Bold" />

                    <Button Content="📂 Open Destination Folder"
                            Command="{Binding OpenExportFolderCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#2D2D32"
                            Foreground="#CCCCCC"
                            Height="38"
                            CornerRadius="6"
                            FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
